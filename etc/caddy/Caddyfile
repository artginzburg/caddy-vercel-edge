# Global options: they must be the first block in the file. Storage and limits
# for the HTTP cache used by (static-cache) below are set once here; the bare
# `cache` directive there inherits them.
#  - otter is in-memory: the cached set is a few MB of build assets, refilled
#    from Vercel in one round-trip per file after a restart.
#  - default_cache_control no-store: a response without Cache-Control is never
#    stored (Souin would otherwise keep it 120 s). Vercel always sends one for
#    the paths cached here; this only guards a future misconfiguration.
#  - no `stale`: serve-stale is unreliable under Caddy (souin#699, #846), and
#    the cached assets are immutable anyway.
{
	cache {
		otter {
			configuration {
				size 5000
			}
		}
		default_cache_control no-store
		max_cacheable_body_bytes 2097152
		timeout {
			backend 30s
			cache 10ms
		}
		key {
			hide
		}
	}
}

# Reusable snippet: structured JSON access log -> /var/log/caddy/access.log
# Powers per-host traffic stats. Add it to any site with: import logged
# See /root/README.md and /usr/local/bin/caddy-stats
(logged) {
	log {
		output file /var/log/caddy/access.log {
			roll_size 100MiB
			roll_keep 12
			roll_keep_for 8760h
		}
		format json
	}
}

# Serve content-hashed build assets (/_next/static, /_astro) from a local
# cache, so a repeat download never reaches Vercel: those files are named by
# their content and sent `immutable`, so a URL can never change its body.
# Vercel picks br/gzip/identity by Accept-Encoding but sends NO Vary header, so
# a cache keyed by URL alone would hand a brotli body to a client that cannot
# read it. Instead the cache asks Vercel for identity, stores that one copy,
# and `encode` compresses it per client — `route` keeps encode OUTSIDE cache
# (with `handle`, Caddy's directive order would put cache first and store one
# variant per Accept-Encoding string). Range requests skip the cache. Nothing
# else is cached: Souin stores Set-Cookie responses and ignores no-cache
# (souin#805, cache-handler#135), so widening this to HTML or APIs needs those
# issues re-read first.
#   Usage:  import static-cache https://origin.example.com  (edge does it)
(static-cache) {
	@build-asset {
		method GET HEAD
		path /_next/static/* /_astro/*
		not header Range *
	}
	route @build-asset {
		encode zstd gzip
		cache
		reverse_proxy {args[0]} {
			header_up X-Edge-Proxy {env.EDGE_PROXY_MARKER}
			header_up Accept-Encoding identity
			import platform-error
		}
	}
}

# Vercel's own error responses (FUNCTION_INVOCATION_TIMEOUT, DEPLOYMENT_NOT_FOUND…)
# carry X-Vercel-Error and a body naming Vercel with the request id. Keep the
# status, swap the body for a neutral page; upstream headers are not copied, so
# X-Vercel-Error goes too. The app's own error pages lack the header and pass.
#   Usage: inside a reverse_proxy block, import platform-error
(platform-error) {
	@platform-error header X-Vercel-Error *
	handle_response @platform-error {
		header Content-Type "text/html; charset=utf-8"
		header Cache-Control no-store
		respond <<HTML
			<!doctype html>
			<html lang="ru">
			<meta charset="utf-8">
			<meta name="viewport" content="width=device-width, initial-scale=1">
			<title>Сервис временно недоступен</title>
			<p style="font: 18px/1.5 system-ui, sans-serif; text-align: center; margin: 30vh 16px">Сервис временно недоступен, попробуйте через минуту.</p>
			</html>
			HTML {rp.status_code}
	}
}

# Reverse-proxy to a Vercel origin AND tag the request with X-Edge-Proxy, so the
# app can redirect *direct* visits to its origin.* host back to the public apex
# (proxied traffic carries the marker and is served as-is). Vercel overwrites
# X-Forwarded-For with this box's IP, so the client IP travels in
# X-Edge-Client-IP-<marker>: the marker in the name keeps a direct request from
# forging it. Build assets are answered from the box's cache first (static-cache above).
# Responses drop the headers that name the hosting (Vercel, Next.js, Caddy); the
# x-nextjs-* ones stay, the client router reads them. A `header` with deletions
# is deferred, so it also strips what reverse_proxy adds (Via) and cached hits.
# Vercel answers its own /_vercel/* paths (analytics, speed insights) on every
# project, so they 404 here. A site whose pages load Vercel Analytics or Speed
# Insights imports edge-proxy instead: the same, without that 404.
#   Usage:  import edge https://origin.example.com
(edge) {
	@platform-path path /_vercel /_vercel/*
	respond @platform-path 404
	import edge-proxy {args[0]}
}

(edge-proxy) {
	header {
		-Server
		-Via
		-X-Powered-By
		-X-Vercel-Id
		-X-Vercel-Cache
		-X-Matched-Path
		-Cache-Status
	}
	import static-cache {args[0]}
	reverse_proxy {args[0]} {
		header_up X-Edge-Proxy {env.EDGE_PROXY_MARKER}
		header_up X-Edge-Client-IP-{env.EDGE_PROXY_MARKER} {client_ip}
		import platform-error
	}
}

# Standard Vercel project behind this proxy: www -> apex (301) and the apex
# proxied to origin.<domain> with the edge marker. The origin->apex redirect for
# direct origin visits lives in the app's next.config redirects() (see README).
# The Vercel origin host MUST be origin.<domain>.
#   Usage:  import vercel example.com
(vercel) {
	www.{args[0]} {
		import logged
		redir https://{args[0]}{uri} permanent
	}
	{args[0]} {
		import logged
		import edge https://origin.{args[0]}
	}
}

# GeoDNS variant of (vercel): the domain's DNS hands this box's IP only to the
# countries you route here (e.g. RU) and Vercel's anycast to everyone else, so
# only the affected region pays the proxy hop. Two differences from (vercel):
#  - No www block. With split-horizon DNS the www record either stays on the
#    direct branch or doesn't exist; add it in your site file if you need it.
#  - Certificates come via DNS-01. ACME validators query from outside the
#    proxied region, resolve the apex to Vercel's edge, and HTTP-01 fails.
#    Needs a Caddy build with your DNS provider's module (github.com/caddy-dns;
#    gcore is not on caddyserver.com's build server — build with xcaddy) and
#    the provider token in edge.env. propagation_timeout -1 skips certmagic's
#    own pre-check, which times out behind freshly delegated zones and stale
#    public-resolver caches; the CA checks the authoritative servers anyway.
#   Usage:  import vercel-geo example.com
(vercel-geo) {
	{args[0]} {
		import logged
		tls {
			dns gcore {env.GCORE_API_TOKEN}
			propagation_timeout -1
		}
		import edge https://origin.{args[0]}
	}
}

# --- Your sites ---------------------------------------------------------------
# Everything in sites/ is loaded here. Keep one file per project, e.g.
# sites/example.com.caddy containing a single `import vercel example.com`.
# install.sh also symlinks it to /etc/caddy/sites, so the glob
# resolves the same whether Caddy reads this file through the symlink or not.
#
# etc/caddy/sites/ is where private configuration lives: it is gitignored here, and can be
# a git submodule pointing at a private repo (see README > Private sites).
import sites/*.caddy
